# ==============================================================================
# PayLoop Environment Variables Configuration
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 1. Supabase (PostgreSQL + Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Stripe (Connect Express, Checkout, Webhooks)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# 3. Google Gemini API (AI Message Content Generation)
GEMINI_API_KEY=your-gemini-api-key

# 4. Resend (Email Delivery & Tracking)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=PayLoop Recovery <onboarding@resend.dev>

# 5. Vercel Cron Secret (Optional, for scheduled escalations)
CRON_SECRET=your-secure-cron-secret
